# انسخ هذا الملف إلى .env وعدّل القيم
NODE_ENV=production            # في الإنتاج: يفعّل الكوكيز الآمنة و HSTS (يحتاج HTTPS)
PORT=3000
PUBLIC_URL=https://your-store.com
TRUST_PROXY=1                  # إذا الموقع خلف Nginx / Cloudflare / Render
# قاعدة البيانات: رابط PostgreSQL (Neon / Supabase / Render). اتركه فاضي محليًا ليستخدم PGlite المدمجة
DATABASE_URL=
# PGLITE_PATH=data/pglite

# رمز إنشاء أول حساب أدمن (إذا تركته فاضي ينطبع رمز عشوائي في سجل الخادم)
SETUP_TOKEN=

# الذكاء الاصطناعي (Claude) — من https://console.anthropic.com
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# الإيميل (SMTP) — مثال: Gmail / Zoho / Brevo / Amazon SES
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ROX Store <orders@your-store.com>"
ADMIN_NOTIFY_EMAIL=
