<Application x:Class="ROX.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#121218"/>
    <SolidColorBrush x:Key="Panel" Color="#1C1C26"/>
    <SolidColorBrush x:Key="Cyan" Color="#19E6E6"/>
    <SolidColorBrush x:Key="Pink" Color="#E040FB"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8E8F0"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8E8F0"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#19E6E6"/>
      <Setter Property="Background" Value="#22222E"/>
      <Setter Property="BorderBrush" Value="#19E6E6"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2E2E40"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="200"/></Style>
  </Application.Resources>
</Application>
