<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ROX" Width="1240" Height="800" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#FF07070D" Foreground="#FFF3F3F8"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" FlowDirection="RightToLeft"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <SolidColorBrush x:Key="Bg" Color="#FF07070D"/>
    <SolidColorBrush x:Key="Side" Color="#FF0B0B13"/>
    <SolidColorBrush x:Key="Panel" Color="#FF0F0F18"/>
    <SolidColorBrush x:Key="Card" Color="#FF13131D"/>
    <SolidColorBrush x:Key="CardHi" Color="#FF1A1A27"/>
    <SolidColorBrush x:Key="Stroke" Color="#FF20203A"/>
    <SolidColorBrush x:Key="Muted" Color="#FF8A8AA6"/>
    <SolidColorBrush x:Key="Dim" Color="#FF5D5D78"/>
    <SolidColorBrush x:Key="GreenSolid" Color="#FF1ED68F"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <LinearGradientBrush x:Key="GreenGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF2BEBA6" Offset="0"/><GradientStop Color="#FF12B579" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlueGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF5B9BFF" Offset="0"/><GradientStop Color="#FF2563EB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RedGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFF6464" Offset="0"/><GradientStop Color="#FFCC2F2F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="YellowGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFFD766" Offset="0"/><GradientStop Color="#FFF0A62A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF8B5CF6" Offset="0"/><GradientStop Color="#FF22D3EE" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== sidebar navigation ===== -->
    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Width" Value="54"/>
      <Setter Property="Height" Value="54"/>
      <Setter Property="Margin" Value="0,5"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="bg" CornerRadius="17" Background="#00FFFFFF"/>
              <Border x:Name="glow" CornerRadius="17" Opacity="0" Background="{StaticResource BrandGrad}">
                <Border.Effect><DropShadowEffect Color="#FF8B5CF6" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
              </Border>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="20"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#14FFFFFF"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard><DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/></Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard><DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/></Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== pill buttons ===== -->
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Foreground" Value="#FF06120D"/>
      <Setter Property="Background" Value="{StaticResource GreenGrad}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="22,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="shadow" CornerRadius="20" Background="{TemplateBinding Background}" Opacity="0.2" Margin="10,10,10,-2">
                <Border.Effect><BlurEffect Radius="10"/></Border.Effect>
              </Border>
              <Border CornerRadius="20" Background="{TemplateBinding Background}">
                <Grid>
                  <Border x:Name="shine" CornerRadius="20" Background="#FFFFFFFF" Opacity="0"/>
                  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="shine" Property="Opacity" Value="0.14"/>
                <Setter TargetName="shadow" Property="Opacity" Value="0.38"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="shine" Property="Opacity" Value="0.26"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.14"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.14"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PillBlue" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource BlueGrad}"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>
    <Style x:Key="PillRed" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource RedGrad}"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>
    <Style x:Key="PillYellow" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource YellowGrad}"/>
      <Setter Property="Foreground" Value="#FF1C1405"/>
    </Style>
    <Style x:Key="PillSmall" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#FFF3F3F8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="BorderBrush" Value="#FF2C2C48"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="20" Background="#0DFFFFFF" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#FF4A4A72"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Background="#00FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="12"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Background="#00FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="12"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFE5484D"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- small round icon button used inside cards -->
    <Style x:Key="RoundIcon" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="#FFF3F3F8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="17" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="13"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== toggles ===== -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#FFF3F3F8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="#FF2A2A3E" VerticalAlignment="Center">
                <Border x:Name="knob" Width="20" Height="20" CornerRadius="10" Background="#FFFFFFFF" HorizontalAlignment="Left" Margin="3,0">
                  <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
                  <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35"/></Border.Effect>
                </Border>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="track" Property="Background" Value="{StaticResource GreenGrad}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="box" Width="22" Height="22" CornerRadius="7" BorderThickness="1.5" BorderBrush="#FF3A3A58" Background="#00FFFFFF">
              <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" FontWeight="Bold"
                         Foreground="#FF06120D" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#FF6A6A92"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource GreenGrad}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#FF1ED68F"/>
                <Setter TargetName="mark" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Star" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="#00FFFFFF" Width="32" Height="32" CornerRadius="16" x:Name="b">
              <TextBlock x:Name="g" Text="&#xE734;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#FF8A8AA6"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="g" Property="Foreground" Value="#FFF3F3F8"/>
                <Setter TargetName="b" Property="Background" Value="#12FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="g" Property="Text" Value="&#xE735;"/>
                <Setter TargetName="g" Property="Foreground" Value="#FFF5C044"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== cards ===== -->
    <Style x:Key="HoverCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="24"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource CardHi}"/>
          <Setter Property="BorderBrush" Value="#FF34345C"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ===== slim scrollbars ===== -->
    <Style x:Key="SlimBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Margin" Value="0,6,4,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="#00000000">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" Background="#33FFFFFF"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Scroll" TargetType="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SlimBar}"
                         Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== GPU vendor tile ===== -->
    <Style x:Key="VendorTile" TargetType="Button">
      <Setter Property="Width" Value="170"/>
      <Setter Property="Height" Value="210"/>
      <Setter Property="Margin" Value="10,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#22FFFFFF"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="26" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.92"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.16"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.16"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>

    <!-- ===== item templates ===== -->
    <DataTemplate x:Key="ModuleCard">
      <Border Style="{StaticResource HoverCard}" Margin="9" Height="124">
        <Grid Margin="22,16,14,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="62" Height="62" CornerRadius="31" Background="#FFF4F4F9" VerticalAlignment="Center">
            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="#FF0B0B12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,10,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource Display}"/>
              <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Background="#2219D38A" Padding="8,2"
                      Visibility="{Binding HasBadge, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#FF2BEBA6" FontWeight="SemiBold"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="34"/>
          </StackPanel>
          <Grid Grid.Column="2">
            <ToggleButton Style="{StaticResource Star}" IsChecked="{Binding IsOn, Mode=TwoWay}" Tag="fav"
                          VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip="تثبيت في الرئيسية"/>
            <Button Style="{StaticResource PillSmall}" Content="طبّق" Tag="run" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="GameCard">
      <Border Width="268" Height="226" CornerRadius="24" Margin="9" Background="{StaticResource Card}"
              BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
              <Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-5" Duration="0:0:0.18"/></Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
              <Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.22"/></Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="126"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border CornerRadius="23,23,0,0" Background="{Binding Accent}">
            <TextBlock Text="{Binding Initial}" FontSize="54" FontWeight="Black" Foreground="#33FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Display}"/>
          </Border>
          <Border CornerRadius="23,23,0,0">
            <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/></Border.Background>
          </Border>
          <Border CornerRadius="23,23,0,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0.35"/><GradientStop Color="#EE13131D" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border Style="{StaticResource Chip}" Margin="14" VerticalAlignment="Top" Background="#99000000">
            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"/>
          </Border>
          <Border CornerRadius="10" Margin="14" Padding="8,3" VerticalAlignment="Top" HorizontalAlignment="Right"
                  Background="#CC12B579" Visibility="{Binding IsOn, Converter={StaticResource B2V}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Text="مُسرّعة" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0"/>
            </StackPanel>
          </Border>
          <Grid Grid.Row="1" Margin="16,8,14,14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Display}"/>
            <Grid Grid.Row="1" VerticalAlignment="Bottom">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" Tag="opt" Content="تسريع" FontSize="12"/>
              <Button Grid.Column="1" Style="{StaticResource RoundIcon}" Content="&#xE8B7;" Tag="exe" Margin="0,0,8,0" ToolTip="اختار ملف اللعبة (.exe)"/>
              <Button Grid.Column="2" Style="{StaticResource PillSmall}" Tag="play" Padding="14,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Text="العب" Margin="6,0,0,0"/>
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AppRow">
      <Border Style="{StaticResource HoverCard}" CornerRadius="16" Margin="0,4" Height="60" Padding="14,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Tag="sel" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Width="36" Height="36" CornerRadius="11" Margin="14,0" Background="{Binding Accent}">
            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
          </StackPanel>
          <Border Grid.Column="3" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="10,0">
            <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#FFC9C9DE"/>
          </Border>
          <TextBlock Grid.Column="4" Text="{Binding Detail}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
          <ToggleButton Grid.Column="5" Style="{StaticResource Star}" IsChecked="{Binding IsOn, Mode=TwoWay}" Tag="keep" Margin="10,0,0,0"
                        VerticalAlignment="Center" ToolTip="خلّه دايم (ROX ما يقفله)"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="CrashCard">
      <Border CornerRadius="20" Margin="0,6" Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid>
          <Border Width="5" HorizontalAlignment="Left" CornerRadius="3" Margin="0,18" Background="{Binding Accent}"/>
          <Grid Margin="26,18,20,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource Display}"/>
                <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#FFC9C9DE"/>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="#FFD6D6E6" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Pill}" Content="{Binding ActionText}" Tag="fix" VerticalAlignment="Center" Margin="16,0,0,0"
                    Visibility="{Binding HasAction, Converter={StaticResource B2V}}"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="LogLine">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="7" Height="7" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Foreground="#FFCFCFE0" TextWrapping="Wrap"
                   FlowDirection="LeftToRight" TextAlignment="Right" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
      </Grid>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="WrapPanelH"><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Grid2"><UniformGrid Columns="2"/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Grid3"><UniformGrid Columns="3"/></ItemsPanelTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="92"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- background glow -->
    <Border Grid.ColumnSpan="2" IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="0.85,0.0" GradientOrigin="0.85,0.0" RadiusX="0.7" RadiusY="0.6">
          <GradientStop Color="#1A8B5CF6" Offset="0"/><GradientStop Color="#0007070D" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <!-- ===================== SIDEBAR ===================== -->
    <Border x:Name="Sidebar" Grid.Column="0" Background="{StaticResource Side}" BorderBrush="#FF15152A" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False">
        <Border DockPanel.Dock="Top" Margin="0,18,0,26" Width="52" Height="52" CornerRadius="17" Background="{StaticResource BrandGrad}">
          <Border.Effect><DropShadowEffect Color="#FF8B5CF6" BlurRadius="26" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
          <TextBlock Text="R" FontSize="28" FontWeight="Black" FontFamily="{StaticResource Display}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
        </Border>
        <RadioButton x:Name="NavHome"     DockPanel.Dock="Top" Style="{StaticResource NavBtn}" Content="&#xE80F;" ToolTip="الرئيسية" IsChecked="True"/>
        <RadioButton x:Name="NavOptimize" DockPanel.Dock="Top" Style="{StaticResource NavBtn}" Content="&#xE945;" ToolTip="التحسينات"/>
        <RadioButton x:Name="NavGames"    DockPanel.Dock="Top" Style="{StaticResource NavBtn}" Content="&#xE7FC;" ToolTip="الألعاب"/>
        <RadioButton x:Name="NavApps"     DockPanel.Dock="Top" Style="{StaticResource NavBtn}" Content="&#xE9D9;" ToolTip="برامج الخلفية"/>
        <RadioButton x:Name="NavCrash"    DockPanel.Dock="Top" Style="{StaticResource NavBtn}" Content="&#xEBE8;" ToolTip="طبيب الكراش"/>
        <RadioButton x:Name="NavSettings" DockPanel.Dock="Top" Style="{StaticResource NavBtn}" Content="&#xE713;" ToolTip="الإعدادات"/>
        <TextBlock DockPanel.Dock="Bottom" Text="ROX" HorizontalAlignment="Center" Margin="0,0,0,20" FontWeight="Black" FontSize="12" Foreground="{StaticResource Dim}"/>
      </DockPanel>
    </Border>

    <!-- ===================== MAIN ===================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Grid Grid.Row="0" Margin="30,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="الرئيسية" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
          <Border x:Name="BusyChip" Style="{StaticResource Chip}" Margin="14,0,0,0" Background="#1A8B5CF6" Visibility="Collapsed" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Stroke="#FFB79CFF" StrokeThickness="2" Data="M 6,1 A 5,5 0 1 1 1,6" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                <Path.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Path.Triggers>
              </Path>
              <TextBlock x:Name="BusyChipText" Text="شغّال..." FontSize="11" Margin="8,0,0,0" Foreground="#FFD8CCFF"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="BtnMin" Style="{StaticResource IconBtn}" Content="&#xE921;"/>
          <Button x:Name="BtnMax" Style="{StaticResource IconBtn}" Content="&#xE922;"/>
          <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" Content="&#xE8BB;"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <!-- ===================== HOME ===================== -->
        <ScrollViewer x:Name="PageHome" Style="{StaticResource Scroll}">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="30,4,30,34">
            <Border CornerRadius="30" Background="{StaticResource Panel}" BorderBrush="#FF181830" BorderThickness="1" Padding="26,22,26,26">
              <StackPanel>
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="نظرة سريعة" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource Display}"/>
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="12,6,0,0" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                  <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1A1ED68F" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Fill="#FF1ED68F" VerticalAlignment="Center"/>
                      <TextBlock x:Name="LiveChip" Text="ROX يراقب ألعابك" FontSize="12" Margin="8,0,0,0" Foreground="#FFB9F5DC"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <UniformGrid Columns="4" Margin="0,20,0,0">
                  <!-- score card (green) -->
                  <Border CornerRadius="26" Background="#FF12121B" BorderThickness="1.3" Margin="0,0,14,0" Height="236">
                    <Border.BorderBrush>
                      <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#DD2BEBA6" Offset="0"/><GradientStop Color="#1A2BEBA6" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                      <Border CornerRadius="26">
                        <Border.Background>
                          <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.95" RadiusY="0.8">
                            <GradientStop Color="#702BEBA6" Offset="0"/><GradientStop Color="#002BEBA6" Offset="1"/>
                          </RadialGradientBrush>
                        </Border.Background>
                      </Border>
                      <StackPanel Margin="20,16,20,18">
                        <TextBlock x:Name="DateText" Text="" FontSize="11" Foreground="#FFB8B8CC"/>
                        <TextBlock x:Name="ScoreText" Text="0%" FontSize="44" FontWeight="Black" HorizontalAlignment="Center" Margin="0,18,0,0" FontFamily="{StaticResource Display}" FlowDirection="LeftToRight"/>
                        <TextBlock Text="تقييم الجهاز" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                        <Grid Margin="4,16,4,0" Height="6">
                          <Border CornerRadius="3" Background="#22FFFFFF"/>
                          <Border x:Name="ScoreFill" CornerRadius="3" Background="{StaticResource GreenGrad}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                          </Border>
                        </Grid>
                        <Button x:Name="BtnFixAll" Style="{StaticResource Pill}" Margin="0,18,0,0" Padding="18,9">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                            <TextBlock Text="حدّث وصلّح كل شي" Margin="8,0,0,0"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- gaming (blue) -->
                  <Border CornerRadius="26" Background="#FF12121B" BorderThickness="1.3" Margin="0,0,14,0" Height="236">
                    <Border.BorderBrush>
                      <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#DD5B9BFF" Offset="0"/><GradientStop Color="#1A5B9BFF" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                      <Border CornerRadius="26">
                        <Border.Background>
                          <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.95" RadiusY="0.8">
                            <GradientStop Color="#705B9BFF" Offset="0"/><GradientStop Color="#005B9BFF" Offset="1"/>
                          </RadialGradientBrush>
                        </Border.Background>
                      </Border>
                      <Grid Margin="20,16,20,18">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,0,40">
                          <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="30" HorizontalAlignment="Center" Foreground="#FFCFE0FF"/>
                          <TextBlock Text="تحسين الألعاب" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="{StaticResource Display}"/>
                          <TextBlock Text="Game Mode + أولوية عالية" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnGaming" Style="{StaticResource PillBlue}" Content="حسّن الآن" VerticalAlignment="Bottom"/>
                      </Grid>
                    </Grid>
                  </Border>

                  <!-- gpu (red) -->
                  <Border CornerRadius="26" Background="#FF12121B" BorderThickness="1.3" Margin="0,0,14,0" Height="236">
                    <Border.BorderBrush>
                      <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#DDFF6464" Offset="0"/><GradientStop Color="#1AFF6464" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                      <Border CornerRadius="26">
                        <Border.Background>
                          <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.95" RadiusY="0.8">
                            <GradientStop Color="#70FF6464" Offset="0"/><GradientStop Color="#00FF6464" Offset="1"/>
                          </RadialGradientBrush>
                        </Border.Background>
                      </Border>
                      <Grid Margin="20,16,20,18">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,0,40">
                          <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="30" HorizontalAlignment="Center" Foreground="#FFFFD6D6"/>
                          <TextBlock Text="إعدادات الكرت" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="{StaticResource Display}"/>
                          <TextBlock x:Name="GpuCardSub" Text="جدولة الكرت + تحديث التعريف" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="BtnGpu" Style="{StaticResource PillRed}" Content="اضبط الآن" VerticalAlignment="Bottom"/>
                      </Grid>
                    </Grid>
                  </Border>

                  <!-- power (yellow) -->
                  <Border CornerRadius="26" Background="#FF12121B" BorderThickness="1.3" Height="236">
                    <Border.BorderBrush>
                      <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#DDFFD766" Offset="0"/><GradientStop Color="#1AFFD766" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                      <Border CornerRadius="26">
                        <Border.Background>
                          <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.95" RadiusY="0.8">
                            <GradientStop Color="#70FFD766" Offset="0"/><GradientStop Color="#00FFD766" Offset="1"/>
                          </RadialGradientBrush>
                        </Border.Background>
                      </Border>
                      <Grid Margin="20,16,20,18">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,0,40">
                          <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="30" HorizontalAlignment="Center" Foreground="#FFFFF0C2"/>
                          <TextBlock Text="الطاقة والمعالج" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="{StaticResource Display}"/>
                          <TextBlock Text="أداء أقصى + Turbo" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnPower" Style="{StaticResource PillYellow}" Content="فعّل الآن" VerticalAlignment="Bottom"/>
                      </Grid>
                    </Grid>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <!-- live stats -->
            <UniformGrid Columns="4" Margin="0,18,0,0">
              <Border Style="{StaticResource HoverCard}" CornerRadius="20" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="المعالج" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="CpuText" Text="--" HorizontalAlignment="Right" FontWeight="Bold" FontSize="15" FlowDirection="LeftToRight"/>
                  </Grid>
                  <Grid Margin="0,12,0,0" Height="5">
                    <Border CornerRadius="3" Background="#1FFFFFFF"/>
                    <Border x:Name="CpuFill" CornerRadius="3" Background="{StaticResource BlueGrad}" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource HoverCard}" CornerRadius="20" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="الكرت" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="GpuText" Text="--" HorizontalAlignment="Right" FontWeight="Bold" FontSize="15" FlowDirection="LeftToRight"/>
                  </Grid>
                  <Grid Margin="0,12,0,0" Height="5">
                    <Border CornerRadius="3" Background="#1FFFFFFF"/>
                    <Border x:Name="GpuFill" CornerRadius="3" Background="{StaticResource RedGrad}" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource HoverCard}" CornerRadius="20" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="الرامات" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="RamText" Text="--" HorizontalAlignment="Right" FontWeight="Bold" FontSize="15" FlowDirection="LeftToRight"/>
                  </Grid>
                  <Grid Margin="0,12,0,0" Height="5">
                    <Border CornerRadius="3" Background="#1FFFFFFF"/>
                    <Border x:Name="RamFill" CornerRadius="3" Background="{StaticResource GreenGrad}" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource HoverCard}" CornerRadius="20" Padding="18,14">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="العمليات" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="ProcText" Text="--" HorizontalAlignment="Right" FontWeight="Bold" FontSize="15" FlowDirection="LeftToRight"/>
                  </Grid>
                  <Grid Margin="0,12,0,0" Height="5">
                    <Border CornerRadius="3" Background="#1FFFFFFF"/>
                    <Border x:Name="ProcFill" CornerRadius="3" Background="{StaticResource YellowGrad}" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- optimize now -->
            <Grid Margin="4,30,4,12">
              <TextBlock Text="حسّن الآن" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource Display}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSeeAll" Style="{StaticResource RoundIcon}" Content="&#xE721;" ToolTip="كل التحسينات" Margin="0,0,8,0"/>
                <Button x:Name="BtnSeeAll2" Style="{StaticResource RoundIcon}" Content="&#xE712;" ToolTip="كل التحسينات"/>
              </StackPanel>
            </Grid>
            <Border Height="1" Background="#FF1A1A30" Margin="0,0,0,12"/>
            <ItemsControl x:Name="HomeModules" ItemTemplate="{StaticResource ModuleCard}" ItemsPanel="{StaticResource Grid2}" Margin="-9,0"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== OPTIMIZE ===================== -->
        <ScrollViewer x:Name="PageOptimize" Style="{StaticResource Scroll}" Visibility="Collapsed">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="30,4,30,34">
            <Grid>
              <StackPanel>
                <TextBlock Text="التحسينات" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource Display}"/>
                <TextBlock Text="طبّق كل شي مرة وحدة، أو اختار اللي تبيه. كل تغيير ينحفظ وتقدر ترجّعه من الإعدادات." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
              </StackPanel>
              <Button x:Name="BtnOptimizeAll" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                  <TextBlock Text="طبّق كل التحسينات" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
            </Grid>
            <ItemsControl x:Name="ModulesList" ItemTemplate="{StaticResource ModuleCard}" ItemsPanel="{StaticResource Grid2}" Margin="-9,20,-9,0"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== GAMES ===================== -->
        <ScrollViewer x:Name="PageGames" Style="{StaticResource Scroll}" Visibility="Collapsed">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="30,4,30,34">
            <Grid>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="الألعاب" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource Display}"/>
                  <Border Style="{StaticResource Chip}" Margin="12,6,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="GamesCount" Text="0" FontSize="12" FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="فعّل التسريع على لعبتك: ROX يشغّلها على الكرت القوي بأولوية عالية، ويقفل برامج الخلفية ويفضّي الرام أول ما تفتحها." Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnRescan" Style="{StaticResource Ghost}" Margin="0,0,10,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                    <TextBlock Text="ابحث عن ألعاب" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnAddGame" Style="{StaticResource Pill}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                    <TextBlock Text="أضف لعبة" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource HoverCard}" CornerRadius="20" Padding="20,14" Margin="0,20,0,8">
              <WrapPanel>
                <CheckBox x:Name="ChkAutoBoost" Style="{StaticResource Switch}" Margin="0,4,40,4">
                  <StackPanel>
                    <TextBlock Text="تسريع تلقائي أول ما تفتح اللعبة" FontWeight="SemiBold"/>
                    <TextBlock Text="ROX يكتشف اللعبة ويسرّعها ويطلع لك إشعار" FontSize="11" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
                <CheckBox x:Name="ChkCloseOnStart" Style="{StaticResource Switch}" Margin="0,4,0,4">
                  <StackPanel>
                    <TextBlock Text="قفّل برامج الخلفية وقت اللعب" FontWeight="SemiBold"/>
                    <TextBlock Text="إلا اللانشرات (Steam...) والبرامج اللي ثبّتها بالنجمة" FontSize="11" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
              </WrapPanel>
            </Border>

            <TextBlock x:Name="GamesEmpty" Visibility="Collapsed" Margin="4,30" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="ما لقينا ألعاب في Steam أو Epic أو Riot. اضغط &quot;أضف لعبة&quot; واختار ملف اللعبة (.exe)."/>
            <ItemsControl x:Name="GamesList" ItemTemplate="{StaticResource GameCard}" ItemsPanel="{StaticResource WrapPanelH}" Margin="-9,8,-9,0"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== BACKGROUND APPS ===================== -->
        <ScrollViewer x:Name="PageApps" Style="{StaticResource Scroll}" Visibility="Collapsed">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="30,4,30,34">
            <TextBlock Text="برامج الخلفية" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource Display}"/>
            <TextBlock Text="قفّل كل شي ما تحتاجه وخلّ بس اللي تستخدمه. اضغط النجمة عشان ROX ما يقفل البرنامج أبد." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>

            <UniformGrid Columns="3" Margin="0,20,0,0">
              <Border CornerRadius="22" Background="#FF12121B" BorderThickness="1.2" Margin="0,0,12,0" Padding="20,16">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#CC2BEBA6" Offset="0"/><GradientStop Color="#002BEBA6" Offset="0.6"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
                <StackPanel>
                  <TextBlock Text="رامات البرامج المفتوحة" FontSize="12" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="AppsRamText" Text="--" FontSize="28" FontWeight="Black" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
              <Border CornerRadius="22" Background="#FF12121B" BorderThickness="1.2" Margin="0,0,12,0" Padding="20,16">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#CC5B9BFF" Offset="0"/><GradientStop Color="#005B9BFF" Offset="0.6"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
                <StackPanel>
                  <TextBlock Text="برامج بالخلفية" FontSize="12" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="AppsCountText" Text="--" FontSize="28" FontWeight="Black" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
              <Border CornerRadius="22" Background="#FF12121B" BorderThickness="1.2" Padding="20,16">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#CCFFD766" Offset="0"/><GradientStop Color="#00FFD766" Offset="0.6"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
                <StackPanel>
                  <TextBlock Text="كل العمليات في الجهاز" FontSize="12" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="AppsProcText" Text="--" FontSize="28" FontWeight="Black" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <WrapPanel Margin="0,20,0,10">
              <Button x:Name="BtnCloseAll" Style="{StaticResource Pill}" Margin="0,0,10,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                  <TextBlock Text="قفّل كل الخلفية" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnCloseSelected" Style="{StaticResource PillBlue}" Content="قفّل المحدد" Margin="0,0,10,8"/>
              <Button x:Name="BtnCleanRam" Style="{StaticResource PillYellow}" Content="فضّي الرام" Margin="0,0,10,8"/>
              <Button x:Name="BtnRefreshApps" Style="{StaticResource Ghost}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                  <TextBlock Text="تحديث" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
            </WrapPanel>
            <TextBlock x:Name="AppsEmpty" Visibility="Collapsed" Margin="4,20" FontSize="14" Foreground="{StaticResource Muted}" Text="ما فيه برامج بالخلفية تحتاج تنقفل. جهازك نظيف!"/>
            <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource AppRow}"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== CRASH DOCTOR ===================== -->
        <ScrollViewer x:Name="PageCrash" Style="{StaticResource Scroll}" Visibility="Collapsed">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="30,4,30,34">
            <Border CornerRadius="30" Background="{StaticResource Panel}" BorderThickness="1.3" Padding="28,24">
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                  <GradientStop Color="#CCFF6464" Offset="0"/><GradientStop Color="#118B5CF6" Offset="0.5"/><GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.BorderBrush>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="72" Height="72" CornerRadius="24" Background="{StaticResource RedGrad}" VerticalAlignment="Center">
                  <Border.Effect><DropShadowEffect Color="#FFFF6464" BlurRadius="30" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
                  <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource Icons}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="22,0" VerticalAlignment="Center">
                  <TextBlock Text="طبيب الكراش" FontSize="26" FontWeight="Bold" FontFamily="{StaticResource Display}"/>
                  <TextBlock Text="لعبة تعلّق أو تطردك أو تطفي؟ ROX يقرا ملفات الكراش في ويندوز، يفهم السبب، ويصلّحه لك." Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                  <TextBlock x:Name="CrashSummary" Text="" Foreground="#FFFFB4B4" Margin="0,8,0,0" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <Button x:Name="BtnScanCrash" Style="{StaticResource PillRed}" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                      <TextBlock Text="افحص الكراشات" Margin="8,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnDeepRepair" Style="{StaticResource Ghost}" Content="إصلاح عميق للويندوز"/>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock x:Name="CrashEmpty" Visibility="Collapsed" Margin="4,24" FontSize="14" Foreground="#FF9EEBC9" TextWrapping="Wrap"
                       Text="ما لقينا أي كراش خلال آخر 14 يوم. جهازك ثابت!"/>
            <ItemsControl x:Name="CrashList" ItemTemplate="{StaticResource CrashCard}" Margin="0,16,0,0"/>
            <TextBlock Margin="4,14,4,0" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                       Text="إذا اللعبة تطردك من السيرفر (Disconnect) بدون كراش: جرّب تحسين الشبكة، وشبّك بكيبل بدال الواي فاي، وقفّل التحميلات وقت اللعب."/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== SETTINGS ===================== -->
        <ScrollViewer x:Name="PageSettings" Style="{StaticResource Scroll}" Visibility="Collapsed">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="30,4,30,34">
            <TextBlock Text="الإعدادات" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource Display}"/>

            <Border Style="{StaticResource HoverCard}" CornerRadius="26" Padding="24,20" Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="كرت الشاشة" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource Display}"/>
                <TextBlock x:Name="SetGpuDetected" Text="" Foreground="{StaticResource Muted}" Margin="0,4,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                  <Button x:Name="SetAmd" Style="{StaticResource VendorTile}" Width="150" Height="96">
                    <Button.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF5A1A1E" Offset="0"/><GradientStop Color="#FF1A0E12" Offset="1"/></LinearGradientBrush>
                    </Button.Background>
                    <TextBlock Text="AMD" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Display}"/>
                  </Button>
                  <Button x:Name="SetNvidia" Style="{StaticResource VendorTile}" Width="150" Height="96">
                    <Button.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF1F4A12" Offset="0"/><GradientStop Color="#FF0D160C" Offset="1"/></LinearGradientBrush>
                    </Button.Background>
                    <TextBlock Text="NVIDIA" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Display}"/>
                  </Button>
                  <Button x:Name="SetIntel" Style="{StaticResource VendorTile}" Width="150" Height="96">
                    <Button.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF133A6B" Offset="0"/><GradientStop Color="#FF0B1424" Offset="1"/></LinearGradientBrush>
                    </Button.Background>
                    <TextBlock Text="intel" FontSize="30" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Display}"/>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource HoverCard}" CornerRadius="26" Padding="24,18" Margin="0,16,0,0">
              <StackPanel>
                <CheckBox x:Name="ChkSetAuto" Style="{StaticResource Switch}" Margin="0,8">
                  <StackPanel>
                    <TextBlock Text="تسريع الألعاب تلقائياً" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="أول ما تفتح لعبة مُسرّعة: يقفل الخلفية، يفضّي الرام، أولوية عالية" FontSize="12" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
                <CheckBox x:Name="ChkSetClose" Style="{StaticResource Switch}" Margin="0,8">
                  <StackPanel>
                    <TextBlock Text="قفّل برامج الخلفية وقت اللعب" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="البرامج اللي فيها نجمة ما تنقفل أبد" FontSize="12" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
                <CheckBox x:Name="ChkSetStartup" Style="{StaticResource Switch}" Margin="0,8">
                  <StackPanel>
                    <TextBlock Text="شغّل ROX مع الويندوز (جنب الساعة)" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="عشان يسرّع ألعابك حتى لو ما فتحت ROX" FontSize="12" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
                <CheckBox x:Name="ChkSetHvci" Style="{StaticResource Switch}" Margin="0,8">
                  <StackPanel>
                    <TextBlock Text="Memory Integrity (حماية الذاكرة)" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="قفلها يعطي فريمات أكثر بس يقلل الحماية - يحتاج ريستارت" FontSize="12" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource HoverCard}" CornerRadius="26" Padding="24,20" Margin="0,16,0,0">
              <Grid>
                <StackPanel>
                  <TextBlock Text="رجّع كل شي مثل ما كان" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="يلغي كل تحسينات ROX ويرجّع إعدادات جهازك الأصلية." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                  <TextBlock x:Name="VersionText" Text="" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="BtnOpenLogs" Style="{StaticResource Ghost}" Content="ملف السجل" Margin="0,0,10,0"/>
                  <Button x:Name="BtnUndoAll" Style="{StaticResource PillRed}" Content="رجّع كل شي"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== ACTIVITY DRAWER ===================== -->
        <Border x:Name="Drawer" VerticalAlignment="Bottom" Height="270" Margin="30,0,30,0" CornerRadius="26,26,0,0"
                Background="#F50F0F18" BorderBrush="#FF2A2A48" BorderThickness="1,1,1,0" Visibility="Collapsed">
          <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
          <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="#FF000000"/></Border.Effect>
          <Grid Margin="24,16,24,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
              <StackPanel Orientation="Horizontal">
                <Grid Width="26" Height="26" VerticalAlignment="Center">
                  <Path x:Name="DrawerSpinner" Width="24" Height="24" Stroke="{StaticResource BrandGrad}" StrokeThickness="3"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 12,2 A 10,10 0 1 1 2,12" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                    <Path.Triggers>
                      <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </Path.Triggers>
                  </Path>
                  <Border x:Name="DrawerDone" Width="24" Height="24" CornerRadius="12" Background="{StaticResource GreenGrad}" Visibility="Collapsed">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#FF06120D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="DrawerTitle" Text="" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DrawerStatus" Text="" FontSize="12" Foreground="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="760"/>
                </StackPanel>
              </StackPanel>
              <Button x:Name="BtnDrawerClose" Style="{StaticResource RoundIcon}" Content="&#xE70D;" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="إخفاء"/>
            </Grid>
            <ScrollViewer x:Name="DrawerScroll" Grid.Row="1" Style="{StaticResource Scroll}" Margin="0,12,0,0">
              <ItemsControl x:Name="DrawerLog" ItemTemplate="{StaticResource LogLine}"/>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- ===================== TOAST ===================== -->
        <Border x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0" CornerRadius="18"
                Background="#FF1A1A28" BorderBrush="#552BEBA6" BorderThickness="1" Padding="18,12" Visibility="Collapsed" IsHitTestVisible="False">
          <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
          <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource GreenGrad}">
              <TextBlock x:Name="ToastIcon" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#FF06120D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="ToastText" Text="" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" MaxWidth="620" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ===================== GPU PICKER MODAL ===================== -->
    <Grid x:Name="ModalGpu" Grid.ColumnSpan="2" Background="#D905050A" Visibility="Collapsed">
      <Border Width="660" CornerRadius="32" Background="#FF12121C" BorderThickness="1.3" Padding="34,30" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#AA8B5CF6" Offset="0"/><GradientStop Color="#2222D3EE" Offset="0.6"/><GradientStop Color="#00000000" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
        <StackPanel>
          <TextBlock Text="اختار كرت الشاشة حقك" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource Display}"/>
          <TextBlock Text="عشان نعطيك أفضل إعدادات وتحديث تعريف تلقائي" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <TextBlock x:Name="ModalDetected" Text="" Foreground="#FF9EEBC9" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0" FlowDirection="LeftToRight">
            <Button x:Name="ModalAmd" Style="{StaticResource VendorTile}">
              <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF6B1F24" Offset="0"/><GradientStop Color="#FF1A0E12" Offset="1"/></LinearGradientBrush>
              </Button.Background>
              <Grid>
                <TextBlock Text="AMD" FontSize="34" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30" FontFamily="{StaticResource Display}"/>
                <Border Background="{StaticResource RedGrad}" CornerRadius="14" Padding="22,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                  <TextBlock Text="اختار" FontWeight="SemiBold" FontSize="12"/>
                </Border>
              </Grid>
            </Button>
            <Button x:Name="ModalNvidia" Style="{StaticResource VendorTile}">
              <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF24581A" Offset="0"/><GradientStop Color="#FF0D160C" Offset="1"/></LinearGradientBrush>
              </Button.Background>
              <Grid>
                <TextBlock Text="NVIDIA" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30" FontFamily="{StaticResource Display}"/>
                <Border Background="{StaticResource GreenGrad}" CornerRadius="14" Padding="22,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                  <TextBlock Text="اختار" FontWeight="SemiBold" FontSize="12" Foreground="#FF06120D"/>
                </Border>
              </Grid>
            </Button>
            <Button x:Name="ModalIntel" Style="{StaticResource VendorTile}">
              <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF17457F" Offset="0"/><GradientStop Color="#FF0B1424" Offset="1"/></LinearGradientBrush>
              </Button.Background>
              <Grid>
                <TextBlock Text="intel" FontSize="38" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30" FontFamily="{StaticResource Display}"/>
                <Border Background="{StaticResource BlueGrad}" CornerRadius="14" Padding="22,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                  <TextBlock Text="اختار" FontWeight="SemiBold" FontSize="12"/>
                </Border>
              </Grid>
            </Button>
          </StackPanel>
          <CheckBox x:Name="ModalDontAsk" Style="{StaticResource Check}" HorizontalAlignment="Center" Margin="0,24,0,0" IsChecked="True" Visibility="Collapsed"/>
          <TextBlock Text="تقدر تغيّره بعدين من الإعدادات" HorizontalAlignment="Center" Margin="0,22,0,0" Foreground="{StaticResource Dim}" FontSize="12"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===================== CONFIRM MODAL ===================== -->
    <Grid x:Name="ModalConfirm" Grid.ColumnSpan="2" Background="#D905050A" Visibility="Collapsed">
      <Border Width="540" CornerRadius="30" Background="#FF12121C" BorderBrush="#FF2A2A48" BorderThickness="1" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="ConfirmTitle" Text="" FontSize="21" FontWeight="Bold" FontFamily="{StaticResource Display}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ConfirmText" Text="" Foreground="#FFC9C9DE" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="21"/>
          <WrapPanel Margin="0,26,0,0">
            <Button x:Name="ConfirmYes" Style="{StaticResource Pill}" Content="يلا" Margin="0,0,10,6"/>
            <Button x:Name="ConfirmAlt" Style="{StaticResource PillBlue}" Content="" Margin="0,0,10,6" Visibility="Collapsed"/>
            <Button x:Name="ConfirmNo" Style="{StaticResource Ghost}" Content="إلغاء" Margin="0,0,0,6"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
