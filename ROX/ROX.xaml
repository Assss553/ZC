<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ROX" Width="1300" Height="830" MinWidth="1140" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#FF06060B" Foreground="#FFF4F4FA"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" FlowDirection="RightToLeft"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <SolidColorBrush x:Key="Surface" Color="#FF0D0D16"/>
    <SolidColorBrush x:Key="Card" Color="#FF11111B"/>
    <SolidColorBrush x:Key="CardHi" Color="#FF171725"/>
    <SolidColorBrush x:Key="Stroke" Color="#FF1D1D33"/>
    <SolidColorBrush x:Key="StrokeHi" Color="#FF30305A"/>
    <SolidColorBrush x:Key="Muted" Color="#FF8C8CA8"/>
    <SolidColorBrush x:Key="Dim" Color="#FF5A5A76"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <LinearGradientBrush x:Key="Brand" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF8B5CF6" Offset="0"/><GradientStop Color="#FF6366F1" Offset="0.5"/><GradientStop Color="#FF06B6D4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandH" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF7C3AED" Offset="0"/><GradientStop Color="#FF4F46E5" Offset="0.55"/><GradientStop Color="#FF0891B2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Green" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF34F5B4" Offset="0"/><GradientStop Color="#FF10B981" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Blue" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF60A5FA" Offset="0"/><GradientStop Color="#FF2563EB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Red" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFF7070" Offset="0"/><GradientStop Color="#FFD7263D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Yellow" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFFDD6E" Offset="0"/><GradientStop Color="#FFF59E0B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Ring" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF34F5B4" Offset="0"/><GradientStop Color="#FF22D3EE" Offset="0.5"/><GradientStop Color="#FF8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===================== sidebar item ===================== -->
    <Style x:Key="SideNav" TargetType="RadioButton">
      <Setter Property="Height" Value="48"/>
      <Setter Property="Margin" Value="16,3"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="bg" CornerRadius="15" Background="#00FFFFFF"/>
              <Border x:Name="sel" CornerRadius="15" Opacity="0" Background="{StaticResource BrandH}">
                <Border.Effect><DropShadowEffect Color="#FF7C3AED" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Icons}"
                           FontSize="17" Width="22" VerticalAlignment="Center" TextAlignment="Center"/>
                <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#10FFFFFF"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- segmented control item (language picker) -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="26,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="12" Background="#00FFFFFF">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource BrandH}"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================== buttons ===================== -->
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Foreground" Value="#FF04130D"/>
      <Setter Property="Background" Value="{StaticResource Green}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="22,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="glow" CornerRadius="22" Background="{TemplateBinding Background}" Opacity="0" Margin="8,10,8,-2">
                <Border.Effect><BlurEffect Radius="12"/></Border.Effect>
              </Border>
              <Border CornerRadius="22" Background="{TemplateBinding Background}">
                <Grid>
                  <Border CornerRadius="22,22,0,0" Height="14" VerticalAlignment="Top" Background="#1FFFFFFF" Margin="1,1,1,0"/>
                  <Border x:Name="shine" CornerRadius="22" Background="#FFFFFFFF" Opacity="0"/>
                  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="shine" Property="Opacity" Value="0.12"/>
                <Setter TargetName="glow" Property="Opacity" Value="0.45"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="shine" Property="Opacity" Value="0.24"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.14"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.14"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PillBlue" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>
    <Style x:Key="PillRed" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource Red}"/><Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>
    <Style x:Key="PillYellow" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource Yellow}"/><Setter Property="Foreground" Value="#FF1D1303"/>
    </Style>
    <Style x:Key="PillBrand" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource BrandH}"/><Setter Property="Foreground" Value="#FFFFFFFF"/>
    </Style>
    <Style x:Key="PillBig" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Padding" Value="28,13"/><Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="PillSmall" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Padding" Value="16,7"/><Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#FFF4F4FA"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="22" Background="#0DFFFFFF" BorderBrush="#FF2B2B4A" BorderThickness="1">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1CFFFFFF"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#FF4C4C7A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Background="#00FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="11"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#18FFFFFF"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Background="#00FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="11"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFE5484D"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RoundIcon" TargetType="Button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="#FFF4F4FA"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="18" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="13"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2AFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================== toggles ===================== -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#FFF4F4FA"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="#FF262638" VerticalAlignment="Center">
                <Border x:Name="knob" Width="20" Height="20" CornerRadius="10" Background="#FFFFFFFF" HorizontalAlignment="Left" Margin="3,0">
                  <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
                  <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35"/></Border.Effect>
                </Border>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="track" Property="Background" Value="{StaticResource Green}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="box" Width="22" Height="22" CornerRadius="7" BorderThickness="1.5" BorderBrush="#FF3A3A5C" Background="#00FFFFFF">
              <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" FontWeight="Bold"
                         Foreground="#FF04130D" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#FF6B6B96"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Green}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#FF10B981"/>
                <Setter TargetName="mark" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Star" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="#00FFFFFF" Width="32" Height="32" CornerRadius="16">
              <TextBlock x:Name="g" Text="&#xE734;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#FF7A7A98"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="g" Property="Foreground" Value="#FFF4F4FA"/>
                <Setter TargetName="b" Property="Background" Value="#12FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="g" Property="Text" Value="&#xE735;"/>
                <Setter TargetName="g" Property="Foreground" Value="#FFFBBF24"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================== surfaces ===================== -->
    <Style x:Key="HoverCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="24"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource CardHi}"/>
          <Setter Property="BorderBrush" Value="{StaticResource StrokeHi}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Section" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="26"/>
      <Setter Property="Padding" Value="26,22"/>
      <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="20"/>
    </Style>

    <!-- slim scrollbar -->
    <Style x:Key="SlimBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Margin" Value="0,6,4,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="#00000000">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#30FFFFFF"/></ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Scroll" TargetType="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SlimBar}"
                         Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- GPU vendor tile -->
    <Style x:Key="VendorTile" TargetType="Button">
      <Setter Property="Width" Value="172"/>
      <Setter Property="Height" Value="206"/>
      <Setter Property="Margin" Value="9,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#22FFFFFF"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="26" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.92"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
          <BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.16"/>
          </Storyboard></BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
          <BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
          </Storyboard></BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>

    <!-- ===================== item templates ===================== -->
    <DataTemplate x:Key="ModuleCard">
      <Border Style="{StaticResource HoverCard}" Margin="9" Height="132">
        <Grid Margin="20,18,14,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="58" Height="58" CornerRadius="19" Background="{Binding Tint}" VerticalAlignment="Center"
                  BorderBrush="{Binding Accent}" BorderThickness="1">
            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{Binding Accent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,10,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource Display}"/>
              <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Background="#2210B981" Padding="8,2" VerticalAlignment="Center"
                      Visibility="{Binding HasBadge, Converter={StaticResource B2V}}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="#FF34F5B4" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#FF6EF0C0" FontWeight="SemiBold" Margin="5,0,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="34"/>
          </StackPanel>
          <Grid Grid.Column="2">
            <ToggleButton Style="{StaticResource Star}" IsChecked="{Binding IsOn, Mode=TwoWay}" Tag="fav"
                          VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip="{DynamicResource S_PinHome}"/>
            <Button Style="{StaticResource PillSmall}" Content="{DynamicResource S_Apply}" Tag="run" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="GameCard">
      <Border Width="270" Height="232" CornerRadius="24" Margin="9" Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-5" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.22"/></Storyboard></BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border CornerRadius="23,23,0,0" Background="{Binding Accent}">
            <TextBlock Text="{Binding Initial}" FontSize="58" FontWeight="Black" Foreground="#30FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Display}"/>
          </Border>
          <Border CornerRadius="23,23,0,0">
            <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/></Border.Background>
          </Border>
          <Border CornerRadius="23,23,0,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0.3"/><GradientStop Color="#F011111B" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border Style="{StaticResource Chip}" Margin="14" VerticalAlignment="Top" Background="#99000000">
            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"/>
          </Border>
          <Border CornerRadius="10" Margin="14" Padding="8,3" VerticalAlignment="Top" HorizontalAlignment="Right"
                  Background="{StaticResource Green}" Visibility="{Binding IsOn, Converter={StaticResource B2V}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Foreground="#FF04130D"/>
              <TextBlock Text="{DynamicResource S_Boosted}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="#FF04130D"/>
            </StackPanel>
          </Border>
          <Grid Grid.Row="1" Margin="16,6,14,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Display}"/>
            <Grid Grid.Row="1" VerticalAlignment="Bottom">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" Tag="opt" Content="{DynamicResource S_Boost}" FontSize="12"/>
              <Button Grid.Column="1" Style="{StaticResource RoundIcon}" Content="&#xE8B7;" Tag="exe" Margin="0,0,8,0" ToolTip="{DynamicResource S_PickExe}"/>
              <Button Grid.Column="2" Style="{StaticResource PillSmall}" Tag="play" Padding="14,7">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource S_Play}" Margin="6,0,0,0"/>
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AppRow">
      <Border Style="{StaticResource HoverCard}" CornerRadius="16" Margin="0,4" Height="62" Padding="14,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Tag="sel" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Width="38" Height="38" CornerRadius="12" Margin="14,0" Background="{Binding Accent}">
            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
          </StackPanel>
          <Border Grid.Column="3" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="10,0">
            <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#FFCBCBE0"/>
          </Border>
          <TextBlock Grid.Column="4" Text="{Binding Detail}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
          <ToggleButton Grid.Column="5" Style="{StaticResource Star}" IsChecked="{Binding IsOn, Mode=TwoWay}" Tag="keep" Margin="10,0,0,0"
                        VerticalAlignment="Center" ToolTip="{DynamicResource S_KeepTip}"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="CrashCard">
      <Border CornerRadius="22" Margin="0,6" Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid>
          <Border Width="5" HorizontalAlignment="Left" CornerRadius="3" Margin="0,18" Background="{Binding Accent}"/>
          <Grid Margin="26,18,20,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource Display}"/>
                <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#FFCBCBE0"/>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="#FFD8D8E8" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Pill}" Content="{Binding ActionText}" Tag="fix" VerticalAlignment="Center" Margin="16,0,0,0"
                    Visibility="{Binding HasAction, Converter={StaticResource B2V}}"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="LogLine">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Ellipse Width="7" Height="7" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Foreground="#FFD0D0E2" TextWrapping="Wrap"
                   FlowDirection="LeftToRight" TextAlignment="{DynamicResource LogAlign}" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
      </Grid>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="WrapPanelH"><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Grid2"><UniformGrid Columns="2"/></ItemsPanelTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ambient glows -->
    <Border Grid.ColumnSpan="2" IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="0.95,0.0" GradientOrigin="0.95,0.0" RadiusX="0.55" RadiusY="0.55">
          <GradientStop Color="#228B5CF6" Offset="0"/><GradientStop Color="#0006060B" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border Grid.ColumnSpan="2" IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="0.2,1.05" GradientOrigin="0.2,1.05" RadiusX="0.55" RadiusY="0.5">
          <GradientStop Color="#1406B6D4" Offset="0"/><GradientStop Color="#0006060B" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <!-- ===================== SIDEBAR ===================== -->
    <Border x:Name="Sidebar" Grid.Column="0" BorderBrush="#FF14142A" BorderThickness="0,0,1,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FF0B0B14" Offset="0"/><GradientStop Color="#FF08080F" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,20,20,30">
          <Viewbox x:Name="LogoHost" Width="48" Height="48" FlowDirection="LeftToRight"/>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="ROX" FontSize="22" FontWeight="Black" FontFamily="{StaticResource Display}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
            <TextBlock Text="{DynamicResource S_Tagline}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,-2,0,0"/>
          </StackPanel>
        </StackPanel>
        <RadioButton x:Name="NavHome"     DockPanel.Dock="Top" Style="{StaticResource SideNav}" Tag="&#xE80F;" Content="{DynamicResource S_NavHome}" IsChecked="True"/>
        <RadioButton x:Name="NavOptimize" DockPanel.Dock="Top" Style="{StaticResource SideNav}" Tag="&#xE945;" Content="{DynamicResource S_NavOptimize}"/>
        <RadioButton x:Name="NavGames"    DockPanel.Dock="Top" Style="{StaticResource SideNav}" Tag="&#xE7FC;" Content="{DynamicResource S_NavGames}"/>
        <RadioButton x:Name="NavApps"     DockPanel.Dock="Top" Style="{StaticResource SideNav}" Tag="&#xE9D9;" Content="{DynamicResource S_NavApps}"/>
        <RadioButton x:Name="NavCrash"    DockPanel.Dock="Top" Style="{StaticResource SideNav}" Tag="&#xEBE8;" Content="{DynamicResource S_NavCrash}"/>
        <RadioButton x:Name="NavSettings" DockPanel.Dock="Top" Style="{StaticResource SideNav}" Tag="&#xE713;" Content="{DynamicResource S_NavSettings}"/>

        <Border DockPanel.Dock="Bottom" Margin="16,0,16,18" CornerRadius="18" Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="16,14">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Grid Width="10" Height="10" VerticalAlignment="Center">
                <Ellipse Fill="#5534F5B4"/>
                <Ellipse Width="6" Height="6" Fill="#FF34F5B4"/>
              </Grid>
              <TextBlock Text="{DynamicResource S_SideStatus}" FontWeight="SemiBold" Margin="10,0,0,0" FontSize="12"/>
            </StackPanel>
            <TextBlock x:Name="SideWatch" Text="" FontSize="11" Foreground="{StaticResource Muted}" Margin="20,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ===================== MAIN ===================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="34,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
          <Border x:Name="BusyChip" Style="{StaticResource Chip}" Margin="14,0,0,0" Background="#1A8B5CF6" Visibility="Collapsed" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Stroke="#FFB9A2FF" StrokeThickness="2" Data="M 6,1 A 5,5 0 1 1 1,6" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                <Path.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard><Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9"/>
                    </Storyboard></BeginStoryboard>
                  </EventTrigger>
                </Path.Triggers>
              </Path>
              <TextBlock x:Name="BusyChipText" Text="" FontSize="11" Margin="8,0,0,0" Foreground="#FFDCD0FF"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="BtnMin" Style="{StaticResource CaptionBtn}" Content="&#xE921;"/>
          <Button x:Name="BtnMax" Style="{StaticResource CaptionBtn}" Content="&#xE922;"/>
          <Button x:Name="BtnClose" Style="{StaticResource CaptionClose}" Content="&#xE8BB;"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <!-- ===================== HOME ===================== -->
        <ScrollViewer x:Name="PageHome" Style="{StaticResource Scroll}">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="34,2,34,36">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

              <!-- hero -->
              <Border CornerRadius="32" Background="#FF0D0D17" BorderThickness="1.2">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#AA8B5CF6" Offset="0"/><GradientStop Color="#2222D3EE" Offset="0.55"/><GradientStop Color="#1A34F5B4" Offset="1"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                  <Border CornerRadius="32">
                    <Border.Background>
                      <RadialGradientBrush Center="0.12,0.15" GradientOrigin="0.12,0.15" RadiusX="0.6" RadiusY="0.95">
                        <GradientStop Color="#448B5CF6" Offset="0"/><GradientStop Color="#008B5CF6" Offset="1"/>
                      </RadialGradientBrush>
                    </Border.Background>
                  </Border>
                  <Border CornerRadius="32">
                    <Border.Background>
                      <RadialGradientBrush Center="0.95,1" GradientOrigin="0.95,1" RadiusX="0.5" RadiusY="0.8">
                        <GradientStop Color="#2206B6D4" Offset="0"/><GradientStop Color="#0006B6D4" Offset="1"/>
                      </RadialGradientBrush>
                    </Border.Background>
                  </Border>
                  <Grid Margin="30,28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="180" Height="180" FlowDirection="LeftToRight" VerticalAlignment="Center">
                      <Ellipse Stroke="#16FFFFFF" StrokeThickness="14" Margin="0"/>
                      <Ellipse Margin="24" Fill="#0AFFFFFF"/>
                      <Path x:Name="ScoreArc" Stroke="{StaticResource Ring}" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Effect><DropShadowEffect Color="#FF22D3EE" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/></Path.Effect>
                      </Path>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScoreText" Text="0" FontSize="50" FontWeight="Black" HorizontalAlignment="Center" FontFamily="{StaticResource Display}"/>
                        <TextBlock Text="{DynamicResource S_ScoreLabel}" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,-4,0,0"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                      <Border Style="{StaticResource Chip}" Background="#148B5CF6">
                        <TextBlock x:Name="DateText" Text="" FontSize="11" Foreground="#FFCBC0F5"/>
                      </Border>
                      <TextBlock Text="{DynamicResource S_HeroHello}" FontSize="32" FontWeight="Bold" FontFamily="{StaticResource Display}" Margin="0,12,0,0"/>
                      <TextBlock x:Name="HeroText" Text="" Style="{StaticResource Sub}" FontSize="13" Margin="0,6,0,0" MaxWidth="420" HorizontalAlignment="Left"/>
                      <WrapPanel Margin="0,20,0,0">
                        <Button x:Name="BtnFixAll" Style="{StaticResource PillBig}" Margin="0,0,10,6">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S_BtnFixAll}" Margin="9,0,0,0"/>
                          </StackPanel>
                        </Button>
                        <Button x:Name="BtnApplyAllHome" Style="{StaticResource Ghost}" Content="{DynamicResource S_BtnApplyAll}" Padding="22,13" Margin="0,0,0,6"/>
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>

              <!-- auto boost -->
              <Border Grid.Column="2" CornerRadius="32" Background="#FF0D0D17" BorderThickness="1.2" Padding="24,24">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#9934F5B4" Offset="0"/><GradientStop Color="#1134F5B4" Offset="0.6"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid>
                    <Border Width="50" Height="50" CornerRadius="17" Background="{StaticResource Green}" HorizontalAlignment="Left">
                      <Border.Effect><DropShadowEffect Color="#FF10B981" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                      <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="#FF04130D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <CheckBox x:Name="ChkHomeAuto" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="{DynamicResource S_AutoTitle}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource S_AutoDesc}" Style="{StaticResource Sub}" FontSize="12" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock x:Name="WatchText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#FF6EF0C0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LastBoostText" Text="" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button x:Name="BtnOpenGames" Grid.Row="3" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                      <TextBlock Text="{DynamicResource S_OpenGames}" Margin="8,0,0,0"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </Grid>

            <!-- quick cards -->
            <UniformGrid Columns="4" Margin="0,18,0,0">
              <Border CornerRadius="26" Background="#FF101019" BorderThickness="1.2" Margin="0,0,14,0" Height="212">
                <Border.BorderBrush><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#DD60A5FA" Offset="0"/><GradientStop Color="#1A60A5FA" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
                <Grid>
                  <Border CornerRadius="26"><Border.Background><RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="0.85"><GradientStop Color="#6660A5FA" Offset="0"/><GradientStop Color="#0060A5FA" Offset="1"/></RadialGradientBrush></Border.Background></Border>
                  <Grid Margin="18,20,18,18">
                    <StackPanel>
                      <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="28" HorizontalAlignment="Center" Foreground="#FFD2E3FF"/>
                      <TextBlock Text="{DynamicResource S_QGamingTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="{StaticResource Display}"/>
                      <TextBlock Text="{DynamicResource S_QGamingSub}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnGaming" Style="{StaticResource PillBlue}" Content="{DynamicResource S_QGamingBtn}" VerticalAlignment="Bottom"/>
                  </Grid>
                </Grid>
              </Border>
              <Border CornerRadius="26" Background="#FF101019" BorderThickness="1.2" Margin="0,0,14,0" Height="212">
                <Border.BorderBrush><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#DDFF7070" Offset="0"/><GradientStop Color="#1AFF7070" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
                <Grid>
                  <Border CornerRadius="26"><Border.Background><RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="0.85"><GradientStop Color="#66FF7070" Offset="0"/><GradientStop Color="#00FF7070" Offset="1"/></RadialGradientBrush></Border.Background></Border>
                  <Grid Margin="18,20,18,18">
                    <StackPanel>
                      <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="28" HorizontalAlignment="Center" Foreground="#FFFFD9D9"/>
                      <TextBlock Text="{DynamicResource S_QGpuTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="{StaticResource Display}"/>
                      <TextBlock x:Name="GpuCardSub" Text="" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="BtnGpu" Style="{StaticResource PillRed}" Content="{DynamicResource S_QGpuBtn}" VerticalAlignment="Bottom"/>
                  </Grid>
                </Grid>
              </Border>
              <Border CornerRadius="26" Background="#FF101019" BorderThickness="1.2" Margin="0,0,14,0" Height="212">
                <Border.BorderBrush><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#DDFFDD6E" Offset="0"/><GradientStop Color="#1AFFDD6E" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
                <Grid>
                  <Border CornerRadius="26"><Border.Background><RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="0.85"><GradientStop Color="#66FFDD6E" Offset="0"/><GradientStop Color="#00FFDD6E" Offset="1"/></RadialGradientBrush></Border.Background></Border>
                  <Grid Margin="18,20,18,18">
                    <StackPanel>
                      <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="28" HorizontalAlignment="Center" Foreground="#FFFFF1C4"/>
                      <TextBlock Text="{DynamicResource S_QPowerTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="{StaticResource Display}"/>
                      <TextBlock Text="{DynamicResource S_QPowerSub}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnPower" Style="{StaticResource PillYellow}" Content="{DynamicResource S_QPowerBtn}" VerticalAlignment="Bottom"/>
                  </Grid>
                </Grid>
              </Border>
              <Border CornerRadius="26" Background="#FF101019" BorderThickness="1.2" Height="212">
                <Border.BorderBrush><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#DD34F5B4" Offset="0"/><GradientStop Color="#1A34F5B4" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
                <Grid>
                  <Border CornerRadius="26"><Border.Background><RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="0.85"><GradientStop Color="#6634F5B4" Offset="0"/><GradientStop Color="#0034F5B4" Offset="1"/></RadialGradientBrush></Border.Background></Border>
                  <Grid Margin="18,20,18,18">
                    <StackPanel>
                      <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="28" HorizontalAlignment="Center" Foreground="#FFCFFBEA"/>
                      <TextBlock Text="{DynamicResource S_QCleanTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="{StaticResource Display}"/>
                      <TextBlock Text="{DynamicResource S_QCleanSub}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnQuickClean" Style="{StaticResource Pill}" Content="{DynamicResource S_QCleanBtn}" VerticalAlignment="Bottom"/>
                  </Grid>
                </Grid>
              </Border>
            </UniformGrid>

            <!-- live stats with sparklines -->
            <UniformGrid Columns="4" Margin="0,18,0,0">
              <Border Style="{StaticResource HoverCard}" CornerRadius="22" Padding="18,14,18,10" Margin="0,0,14,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource S_StatCpu}" Foreground="{StaticResource Muted}" FontSize="12"/>
                  <TextBlock x:Name="CpuText" Text="--" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" FlowDirection="LeftToRight"/>
                  <Canvas x:Name="CpuChart" Grid.Row="1" Margin="0,8,0,0" ClipToBounds="True" FlowDirection="LeftToRight">
                    <Polygon x:Name="CpuArea"><Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#5560A5FA" Offset="0"/><GradientStop Color="#0060A5FA" Offset="1"/></LinearGradientBrush></Polygon.Fill></Polygon>
                    <Polyline x:Name="CpuLine" Stroke="#FF60A5FA" StrokeThickness="2" StrokeLineJoin="Round"/>
                  </Canvas>
                </Grid>
              </Border>
              <Border Style="{StaticResource HoverCard}" CornerRadius="22" Padding="18,14,18,10" Margin="0,0,14,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource S_StatGpu}" Foreground="{StaticResource Muted}" FontSize="12"/>
                  <TextBlock x:Name="GpuText" Text="--" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" FlowDirection="LeftToRight"/>
                  <Canvas x:Name="GpuChart" Grid.Row="1" Margin="0,8,0,0" ClipToBounds="True" FlowDirection="LeftToRight">
                    <Polygon x:Name="GpuArea"><Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#55FF7070" Offset="0"/><GradientStop Color="#00FF7070" Offset="1"/></LinearGradientBrush></Polygon.Fill></Polygon>
                    <Polyline x:Name="GpuLine" Stroke="#FFFF7070" StrokeThickness="2" StrokeLineJoin="Round"/>
                  </Canvas>
                </Grid>
              </Border>
              <Border Style="{StaticResource HoverCard}" CornerRadius="22" Padding="18,14,18,10" Margin="0,0,14,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource S_StatRam}" Foreground="{StaticResource Muted}" FontSize="12"/>
                  <TextBlock x:Name="RamText" Text="--" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" FlowDirection="LeftToRight"/>
                  <Canvas x:Name="RamChart" Grid.Row="1" Margin="0,8,0,0" ClipToBounds="True" FlowDirection="LeftToRight">
                    <Polygon x:Name="RamArea"><Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#5534F5B4" Offset="0"/><GradientStop Color="#0034F5B4" Offset="1"/></LinearGradientBrush></Polygon.Fill></Polygon>
                    <Polyline x:Name="RamLine" Stroke="#FF34F5B4" StrokeThickness="2" StrokeLineJoin="Round"/>
                  </Canvas>
                </Grid>
              </Border>
              <Border Style="{StaticResource HoverCard}" CornerRadius="22" Padding="18,14,18,10">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource S_StatProc}" Foreground="{StaticResource Muted}" FontSize="12"/>
                  <TextBlock x:Name="ProcText" Text="--" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" FlowDirection="LeftToRight"/>
                  <Canvas x:Name="ProcChart" Grid.Row="1" Margin="0,8,0,0" ClipToBounds="True" FlowDirection="LeftToRight">
                    <Polygon x:Name="ProcArea"><Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#55FFDD6E" Offset="0"/><GradientStop Color="#00FFDD6E" Offset="1"/></LinearGradientBrush></Polygon.Fill></Polygon>
                    <Polyline x:Name="ProcLine" Stroke="#FFFFDD6E" StrokeThickness="2" StrokeLineJoin="Round"/>
                  </Canvas>
                </Grid>
              </Border>
            </UniformGrid>

            <Grid Margin="4,30,4,12">
              <TextBlock Text="{DynamicResource S_OptimizeNow}" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource Display}"/>
              <Button x:Name="BtnSeeAll" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Padding="16,7">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{DynamicResource S_SeeAll}"/>
                  <TextBlock x:Name="SeeAllArrow" Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
            </Grid>
            <ItemsControl x:Name="HomeModules" ItemTemplate="{StaticResource ModuleCard}" ItemsPanel="{StaticResource Grid2}" Margin="-9,0"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== OPTIMIZE ===================== -->
        <ScrollViewer x:Name="PageOptimize" Style="{StaticResource Scroll}" Visibility="Collapsed">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="34,2,34,36">
            <Grid>
              <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource S_OptTitle}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource S_OptDesc}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
              </StackPanel>
              <Button x:Name="BtnOptimizeAll" Style="{StaticResource PillBig}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource S_OptApplyAll}" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
            </Grid>
            <ItemsControl x:Name="ModulesList" ItemTemplate="{StaticResource ModuleCard}" ItemsPanel="{StaticResource Grid2}" Margin="-9,22,-9,0"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== GAMES ===================== -->
        <ScrollViewer x:Name="PageGames" Style="{StaticResource Scroll}" Visibility="Collapsed">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="34,2,34,36">
            <Grid>
              <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{DynamicResource S_GamesTitle}" Style="{StaticResource H1}"/>
                  <Border Style="{StaticResource Chip}" Margin="12,8,0,0" VerticalAlignment="Center" Background="#228B5CF6">
                    <TextBlock x:Name="GamesCount" Text="0" FontSize="12" FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{DynamicResource S_GamesDesc}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnRescan" Style="{StaticResource Ghost}" Margin="0,0,10,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource S_Rescan}" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnAddGame" Style="{StaticResource Pill}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource S_AddGame}" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource Section}" Margin="0,22,0,8" Padding="22,16">
              <WrapPanel>
                <CheckBox x:Name="ChkAutoBoost" Style="{StaticResource Switch}" Margin="0,4,40,4">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource S_AutoBoost}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource S_AutoBoostSub}" FontSize="11" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
                <CheckBox x:Name="ChkCloseOnStart" Style="{StaticResource Switch}" Margin="0,4,0,4">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource S_CloseOnStart}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource S_CloseOnStartSub}" FontSize="11" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
              </WrapPanel>
            </Border>
            <TextBlock x:Name="GamesEmpty" Visibility="Collapsed" Margin="4,30" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="{DynamicResource S_GamesEmpty}"/>
            <ItemsControl x:Name="GamesList" ItemTemplate="{StaticResource GameCard}" ItemsPanel="{StaticResource WrapPanelH}" Margin="-9,8,-9,0"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== BACKGROUND APPS ===================== -->
        <ScrollViewer x:Name="PageApps" Style="{StaticResource Scroll}" Visibility="Collapsed">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="34,2,34,36">
            <TextBlock Text="{DynamicResource S_AppsTitle}" Style="{StaticResource H1}"/>
            <TextBlock Text="{DynamicResource S_AppsDesc}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
            <UniformGrid Columns="3" Margin="0,22,0,0">
              <Border CornerRadius="24" Background="#FF101019" BorderThickness="1.2" Margin="0,0,14,0" Padding="22,18">
                <Border.BorderBrush><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#CC34F5B4" Offset="0"/><GradientStop Color="#0034F5B4" Offset="0.6"/></LinearGradientBrush></Border.BorderBrush>
                <StackPanel>
                  <TextBlock Text="{DynamicResource S_AppsRam}" FontSize="12" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="AppsRamText" Text="--" FontSize="30" FontWeight="Black" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontFamily="{StaticResource Display}"/>
                </StackPanel>
              </Border>
              <Border CornerRadius="24" Background="#FF101019" BorderThickness="1.2" Margin="0,0,14,0" Padding="22,18">
                <Border.BorderBrush><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#CC60A5FA" Offset="0"/><GradientStop Color="#0060A5FA" Offset="0.6"/></LinearGradientBrush></Border.BorderBrush>
                <StackPanel>
                  <TextBlock Text="{DynamicResource S_AppsCount}" FontSize="12" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="AppsCountText" Text="--" FontSize="30" FontWeight="Black" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontFamily="{StaticResource Display}"/>
                </StackPanel>
              </Border>
              <Border CornerRadius="24" Background="#FF101019" BorderThickness="1.2" Padding="22,18">
                <Border.BorderBrush><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#CCFFDD6E" Offset="0"/><GradientStop Color="#00FFDD6E" Offset="0.6"/></LinearGradientBrush></Border.BorderBrush>
                <StackPanel>
                  <TextBlock Text="{DynamicResource S_AppsProcs}" FontSize="12" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="AppsProcText" Text="--" FontSize="30" FontWeight="Black" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontFamily="{StaticResource Display}"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <WrapPanel Margin="0,20,0,10">
              <Button x:Name="BtnCloseAll" Style="{StaticResource Pill}" Margin="0,0,10,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource S_CloseAll}" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnCloseSelected" Style="{StaticResource PillBlue}" Content="{DynamicResource S_CloseSelected}" Margin="0,0,10,8"/>
              <Button x:Name="BtnCleanRam" Style="{StaticResource PillYellow}" Content="{DynamicResource S_FreeRam}" Margin="0,0,10,8"/>
              <Button x:Name="BtnRefreshApps" Style="{StaticResource Ghost}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource S_Refresh}" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
            </WrapPanel>
            <TextBlock x:Name="AppsEmpty" Visibility="Collapsed" Margin="4,20" FontSize="14" Foreground="{StaticResource Muted}" Text="{DynamicResource S_AppsEmpty}"/>
            <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource AppRow}"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== CRASH DOCTOR ===================== -->
        <ScrollViewer x:Name="PageCrash" Style="{StaticResource Scroll}" Visibility="Collapsed">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="34,2,34,36">
            <Border CornerRadius="32" Background="#FF0D0D17" BorderThickness="1.2">
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                  <GradientStop Color="#CCFF7070" Offset="0"/><GradientStop Color="#118B5CF6" Offset="0.5"/><GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.BorderBrush>
              <Grid>
                <Border CornerRadius="32">
                  <Border.Background>
                    <RadialGradientBrush Center="0.05,0.2" GradientOrigin="0.05,0.2" RadiusX="0.45" RadiusY="1.1">
                      <GradientStop Color="#33FF7070" Offset="0"/><GradientStop Color="#00FF7070" Offset="1"/>
                    </RadialGradientBrush>
                  </Border.Background>
                </Border>
                <Grid Margin="30,26">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="76" Height="76" CornerRadius="25" Background="{StaticResource Red}" VerticalAlignment="Center">
                    <Border.Effect><DropShadowEffect Color="#FFFF7070" BlurRadius="30" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
                    <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource Icons}" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource S_CrashTitle}" Style="{StaticResource H1}" FontSize="28"/>
                    <TextBlock Text="{DynamicResource S_CrashDesc}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="CrashSummary" Text="" Foreground="#FFFFB8B8" Margin="0,8,0,0" FontWeight="SemiBold"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="BtnScanCrash" Style="{StaticResource PillRed}" Margin="0,0,0,10">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource S_ScanCrash}" Margin="8,0,0,0"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="BtnDeepRepair" Style="{StaticResource Ghost}" Content="{DynamicResource S_DeepRepair}"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
            <TextBlock x:Name="CrashEmpty" Visibility="Collapsed" Margin="4,24" FontSize="14" Foreground="#FF9EEBC9" TextWrapping="Wrap" Text="{DynamicResource S_CrashEmpty}"/>
            <ItemsControl x:Name="CrashList" ItemTemplate="{StaticResource CrashCard}" Margin="0,16,0,0"/>
            <TextBlock Margin="4,14,4,0" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Text="{DynamicResource S_CrashTip}"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== SETTINGS ===================== -->
        <ScrollViewer x:Name="PageSettings" Style="{StaticResource Scroll}" Visibility="Collapsed">
          <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <StackPanel Margin="34,2,34,36">
            <TextBlock Text="{DynamicResource S_SetTitle}" Style="{StaticResource H1}"/>

            <!-- language -->
            <Border Style="{StaticResource Section}" Margin="0,22,0,0">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="46" Height="46" CornerRadius="15" Background="#228B5CF6" BorderBrush="#558B5CF6" BorderThickness="1">
                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#FFC4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource S_SetLangTitle}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource S_SetLangDesc}" Style="{StaticResource Sub}" FontSize="12"/>
                  </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="4">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LangAr" Style="{StaticResource Segment}" GroupName="lang" Content="العربية"/>
                    <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" GroupName="lang" Content="English"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- gpu -->
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{DynamicResource S_SetGpuTitle}" Style="{StaticResource H2}"/>
                <TextBlock x:Name="SetGpuDetected" Text="" Style="{StaticResource Sub}" Margin="0,4,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                  <Button x:Name="SetAmd" Style="{StaticResource VendorTile}" Width="150" Height="92" Margin="0,0,14,0">
                    <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF5E1A20" Offset="0"/><GradientStop Color="#FF1A0D11" Offset="1"/></LinearGradientBrush></Button.Background>
                    <TextBlock Text="AMD" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Display}"/>
                  </Button>
                  <Button x:Name="SetNvidia" Style="{StaticResource VendorTile}" Width="150" Height="92" Margin="0,0,14,0">
                    <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF1F4D14" Offset="0"/><GradientStop Color="#FF0C150B" Offset="1"/></LinearGradientBrush></Button.Background>
                    <TextBlock Text="NVIDIA" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Display}"/>
                  </Button>
                  <Button x:Name="SetIntel" Style="{StaticResource VendorTile}" Width="150" Height="92" Margin="0">
                    <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF143C70" Offset="0"/><GradientStop Color="#FF0A1323" Offset="1"/></LinearGradientBrush></Button.Background>
                    <TextBlock Text="intel" FontSize="30" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Display}"/>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- behaviour -->
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{DynamicResource S_SetBehaviour}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkSetAuto" Style="{StaticResource Switch}" Margin="0,8">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource S_SetAuto}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{DynamicResource S_SetAutoSub}" FontSize="12" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
                <CheckBox x:Name="ChkSetClose" Style="{StaticResource Switch}" Margin="0,8">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource S_SetClose}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{DynamicResource S_SetCloseSub}" FontSize="12" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
                <CheckBox x:Name="ChkSetStartup" Style="{StaticResource Switch}" Margin="0,8">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource S_SetStartup}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{DynamicResource S_SetStartupSub}" FontSize="12" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </Border>

            <!-- advanced -->
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{DynamicResource S_SetAdvanced}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkSetHvci" Style="{StaticResource Switch}" Margin="0,8">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource S_SetHvci}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{DynamicResource S_SetHvciSub}" FontSize="12" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </Border>

            <!-- about + undo -->
            <Border Style="{StaticResource Section}">
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <Viewbox x:Name="AboutLogoHost" Width="60" Height="60" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                  <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ROX" FontSize="20" FontWeight="Black" FontFamily="{StaticResource Display}" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                    <TextBlock Text="{DynamicResource S_SetAboutDesc}" Style="{StaticResource Sub}" FontSize="12"/>
                    <TextBlock x:Name="VersionText" Text="" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,4,0,0"/>
                  </StackPanel>
                </StackPanel>
                <Button x:Name="BtnOpenLogs" Style="{StaticResource Ghost}" Content="{DynamicResource S_SetLogs}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource Section}" BorderBrush="#33FF7070">
              <Grid>
                <StackPanel>
                  <TextBlock Text="{DynamicResource S_SetUndoTitle}" Style="{StaticResource H2}" FontSize="16"/>
                  <TextBlock Text="{DynamicResource S_SetUndoDesc}" Style="{StaticResource Sub}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="BtnUndoAll" Style="{StaticResource PillRed}" Content="{DynamicResource S_SetUndoBtn}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== ACTIVITY DRAWER ===================== -->
        <Border x:Name="Drawer" VerticalAlignment="Bottom" Height="276" Margin="34,0,34,0" CornerRadius="28,28,0,0"
                Background="#F70E0E17" BorderBrush="#FF2A2A4A" BorderThickness="1,1,1,0" Visibility="Collapsed">
          <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
          <Border.Effect><DropShadowEffect BlurRadius="44" ShadowDepth="0" Opacity="0.65" Color="#FF000000"/></Border.Effect>
          <Grid Margin="26,18,26,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
              <StackPanel Orientation="Horizontal">
                <Grid Width="28" Height="28" VerticalAlignment="Center">
                  <Path x:Name="DrawerSpinner" Width="26" Height="26" Stroke="{StaticResource Brand}" StrokeThickness="3"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 13,2 A 11,11 0 1 1 2,13" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                    <Path.Triggers>
                      <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard><Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8"/>
                        </Storyboard></BeginStoryboard>
                      </EventTrigger>
                    </Path.Triggers>
                  </Path>
                  <Border x:Name="DrawerDone" Width="26" Height="26" CornerRadius="13" Background="{StaticResource Green}" Visibility="Collapsed">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#FF04130D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="DrawerTitle" Text="" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DrawerStatus" Text="" FontSize="12" Foreground="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="760"/>
                </StackPanel>
              </StackPanel>
              <Button x:Name="BtnDrawerClose" Style="{StaticResource RoundIcon}" Content="&#xE70D;" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{DynamicResource S_Hide}"/>
            </Grid>
            <ScrollViewer x:Name="DrawerScroll" Grid.Row="1" Style="{StaticResource Scroll}" Margin="0,12,0,0">
              <ItemsControl x:Name="DrawerLog" ItemTemplate="{StaticResource LogLine}"/>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- ===================== TOAST ===================== -->
        <Border x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" CornerRadius="18"
                Background="#FF181826" BorderBrush="#5534F5B4" BorderThickness="1" Padding="16,11" Visibility="Collapsed" IsHitTestVisible="False">
          <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
          <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Green}">
              <TextBlock x:Name="ToastIcon" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#FF04130D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="ToastText" Text="" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" MaxWidth="640" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ===================== WELCOME / GPU MODAL ===================== -->
    <Grid x:Name="ModalGpu" Grid.ColumnSpan="2" Background="#DD040408" Visibility="Collapsed">
      <Border Width="700" CornerRadius="34" Background="#FF10101A" BorderThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#AA8B5CF6" Offset="0"/><GradientStop Color="#2222D3EE" Offset="0.6"/><GradientStop Color="#00000000" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect><DropShadowEffect BlurRadius="70" ShadowDepth="0" Opacity="0.75"/></Border.Effect>
        <Grid>
          <Border CornerRadius="34">
            <Border.Background>
              <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.7" RadiusY="0.5">
                <GradientStop Color="#338B5CF6" Offset="0"/><GradientStop Color="#008B5CF6" Offset="1"/>
              </RadialGradientBrush>
            </Border.Background>
          </Border>
          <StackPanel Margin="36,28,36,30">
            <Border HorizontalAlignment="Right" CornerRadius="14" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="3">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModalLangAr" Style="{StaticResource Segment}" GroupName="lang2" Content="العربية" Padding="16,6" FontSize="12"/>
                <RadioButton x:Name="ModalLangEn" Style="{StaticResource Segment}" GroupName="lang2" Content="English" Padding="16,6" FontSize="12"/>
              </StackPanel>
            </Border>
            <Viewbox x:Name="ModalLogoHost" Width="76" Height="76" HorizontalAlignment="Center" FlowDirection="LeftToRight" Margin="0,-8,0,0"/>
            <TextBlock Text="{DynamicResource S_WelcomeTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#FFC4B5FD" Margin="0,12,0,0"/>
            <TextBlock Text="{DynamicResource S_ModalTitle}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource Display}" Margin="0,4,0,0"/>
            <TextBlock Text="{DynamicResource S_ModalDesc}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock x:Name="ModalDetected" Text="" Foreground="#FF9EEBC9" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0" FlowDirection="LeftToRight">
              <Button x:Name="ModalAmd" Style="{StaticResource VendorTile}">
                <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF6E1F25" Offset="0"/><GradientStop Color="#FF1A0D11" Offset="1"/></LinearGradientBrush></Button.Background>
                <Grid>
                  <TextBlock Text="AMD" FontSize="34" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30" FontFamily="{StaticResource Display}"/>
                  <Border Background="{StaticResource Red}" CornerRadius="14" Padding="22,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                    <TextBlock Text="{DynamicResource S_Select}" FontWeight="SemiBold" FontSize="12"/>
                  </Border>
                </Grid>
              </Button>
              <Button x:Name="ModalNvidia" Style="{StaticResource VendorTile}">
                <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF255B1A" Offset="0"/><GradientStop Color="#FF0C150B" Offset="1"/></LinearGradientBrush></Button.Background>
                <Grid>
                  <TextBlock Text="NVIDIA" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30" FontFamily="{StaticResource Display}"/>
                  <Border Background="{StaticResource Green}" CornerRadius="14" Padding="22,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                    <TextBlock Text="{DynamicResource S_Select}" FontWeight="SemiBold" FontSize="12" Foreground="#FF04130D"/>
                  </Border>
                </Grid>
              </Button>
              <Button x:Name="ModalIntel" Style="{StaticResource VendorTile}">
                <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF18467F" Offset="0"/><GradientStop Color="#FF0A1323" Offset="1"/></LinearGradientBrush></Button.Background>
                <Grid>
                  <TextBlock Text="intel" FontSize="38" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30" FontFamily="{StaticResource Display}"/>
                  <Border Background="{StaticResource Blue}" CornerRadius="14" Padding="22,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                    <TextBlock Text="{DynamicResource S_Select}" FontWeight="SemiBold" FontSize="12"/>
                  </Border>
                </Grid>
              </Button>
            </StackPanel>
            <TextBlock Text="{DynamicResource S_ModalLater}" HorizontalAlignment="Center" Margin="0,22,0,0" Foreground="{StaticResource Dim}" FontSize="12"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== CONFIRM MODAL ===================== -->
    <Grid x:Name="ModalConfirm" Grid.ColumnSpan="2" Background="#DD040408" Visibility="Collapsed">
      <Border Width="560" CornerRadius="30" Background="#FF10101A" BorderBrush="#FF2A2A4A" BorderThickness="1" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="ConfirmTitle" Text="" FontSize="21" FontWeight="Bold" FontFamily="{StaticResource Display}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ConfirmText" Text="" Foreground="#FFCBCBE0" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="21"/>
          <WrapPanel Margin="0,26,0,0">
            <Button x:Name="ConfirmYes" Style="{StaticResource Pill}" Content="" Margin="0,0,10,6"/>
            <Button x:Name="ConfirmAlt" Style="{StaticResource PillBlue}" Content="" Margin="0,0,10,6" Visibility="Collapsed"/>
            <Button x:Name="ConfirmNo" Style="{StaticResource Ghost}" Content="" Margin="0,0,0,6"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
