<resources>
    <style name="Theme.Rox" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rox_black</item>
        <item name="android:statusBarColor">@color/rox_black</item>
        <item name="android:navigationBarColor">@color/rox_black</item>
        <item name="android:colorAccent">@color/rox_orange</item>
    </style>
    <style name="Theme.Rox.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rox_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Rox</item>
    </style>
</resources>
