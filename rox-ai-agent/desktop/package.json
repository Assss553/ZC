{
  "name": "rox-ai-agent",
  "productName": "ROX AI Agent",
  "version": "0.1.0",
  "description": "ROX AI Desktop Agent for Windows 11",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.rox.agent",
    "productName": "ROX AI Agent",
    "files": [
      "build/icon.ico",
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/rox-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}