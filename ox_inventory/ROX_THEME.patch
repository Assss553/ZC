@@ -562,3 +562,162 @@ body.inv-dragging {
   transform: translateY(200px);
   transition: all 200ms;
 }
+
+/* =====================================================================
+   ROX Store inventory theme  (layout: pockets | loadout | drop)
+   ===================================================================== */
+$rox-slot: 9.2vh;
+$rox-line: rgba(255, 255, 255, 0.06);
+
+.inventory-wrapper {
+  gap: 6vh !important;
+  align-items: flex-start !important;
+  padding-top: 7vh;
+  transform: perspective(1600px) rotateY(8deg) rotateX(2deg);
+  transform-origin: 20% 50%;
+}
+.inventory-grid-wrapper.rox-left .inventory-grid-header-wrapper,
+.inventory-grid-wrapper.rox-right .inventory-grid-header-wrapper {
+  display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.2vh;
+  p { font-size: 1.45vh; font-weight: 700; color: #e9e9ea; }
+  .rox-weight { font-weight: 600; color: #cfd0d3; }
+}
+.inventory-grid-wrapper.rox-left .weight-bar, .inventory-grid-wrapper.rox-right .weight-bar { display: none; }
+.inventory-grid-container {
+  grid-template-columns: repeat(5, $rox-slot) !important;
+  grid-auto-rows: $rox-slot !important;
+  gap: 2.4vh 0.9vh !important;
+  height: auto !important; max-height: 60vh;
+}
+.inventory-grid-wrapper.rox-right .inventory-grid-container { max-height: 30vh; }
+
+/* slot */
+.rox-slot {
+  position: relative; width: 100%; height: 100%; border-radius: 0.3vh;
+  background: rgba(25, 25, 27, 0.4) !important; border: 1px solid $rox-line !important;
+  overflow: visible; image-rendering: -webkit-optimize-contrast;
+}
+.rox-slot-bg { position: absolute; inset: 0; border-radius: 0.3vh; overflow: hidden; }
+.rox-slot:not(.rarity-empty) .rox-slot-bg::before, .rox-tip-img .rox-slot-bg::before {
+  content: ''; position: absolute; inset: 0;
+  background: repeating-linear-gradient(135deg, rgba(0,0,0,.28) 0 2px, rgba(255,255,255,.035) 2px 4px, transparent 4px 9px);
+}
+.rarity-common .rox-slot-bg { background: linear-gradient(135deg, #46484d, #232427 60%, #1b1c1e); }
+.rarity-uncommon .rox-slot-bg { background: radial-gradient(120% 120% at 0% 0%, #2f7a4c 0%, #1e2c24 50%, #1b1c1e 80%); }
+.rarity-rare .rox-slot-bg { background: radial-gradient(120% 120% at 0% 0%, #2e6bc0 0%, #1d2b40 50%, #1b1c1e 80%); }
+.rarity-epic .rox-slot-bg { background: radial-gradient(120% 120% at 0% 0%, #7b45b8 0%, #2a1f3b 50%, #1b1c1e 80%); }
+.rarity-legendary .rox-slot-bg { background: radial-gradient(120% 120% at 0% 0%, #c98a24 0%, #3a2c16 50%, #1b1c1e 80%); }
+.rox-slot-img {
+  position: absolute; inset: 12%; background-size: contain; background-repeat: no-repeat; background-position: center;
+  filter: drop-shadow(0 0.4vh 0.5vh rgba(0, 0, 0, 0.6)); pointer-events: none;
+}
+.rox-slot .item-slot-wrapper { position: absolute; inset: 0; }
+.rox-slot-count { position: absolute; right: 0.45vh; top: 0.35vh; font-size: 1.05vh; font-weight: 700; color: #e6e6e6; text-shadow: 0 1px 2px #000; }
+.rox-slot-number {
+  position: absolute; left: 0.45vh; bottom: 0.4vh; width: 1.6vh; height: 1.6vh; border-radius: 0.2vh; background: #e9e9ea; color: #111;
+  font-size: 1.05vh; font-weight: 800; display: grid; place-items: center; z-index: 2;
+}
+.rox-slot-ring {
+  position: absolute; left: 50%; bottom: -1.75vh; transform: translateX(-50%); width: 1.15vh; height: 1.15vh; border-radius: 50%;
+  border: 0.22vh solid #47d17e; z-index: 2;
+  &.mid { border-color: #7a7d83; } &.low { border-color: #c9b04a; }
+}
+.rox-slot-price { position: absolute; left: 0.5vh; bottom: 0.4vh; font-size: 1.15vh; font-weight: 700; display: flex; gap: 0.3vh; align-items: center; img { height: 1.6vh; } }
+.rox-over { outline: 2px solid #fff; outline-offset: 1px; }
+.inventory-slot-label-box, .item-slot-info-wrapper { display: none; }
+
+/* loadout column */
+.rox-mid { display: flex; flex-direction: column; width: 19vh; padding-top: 3.2vh; }
+.rox-h { font-size: 1.45vh; font-weight: 700; color: #e9e9ea; margin: 0 0 0.9vh; }
+.rox-pair { display: flex; gap: 1.6vh; margin-bottom: 2.2vh; }
+.rox-pair-slot { position: relative; width: 7.6vh; height: 7.6vh; }
+.rox-ok { position: absolute; right: -1.9vh; bottom: 0.4vh; width: 1.15vh; height: 1.15vh; border-radius: 50%; border: 0.22vh solid #47d17e; }
+.rox-quick { display: flex; gap: 0.9vh; margin-bottom: 2.6vh; }
+.rox-quick .rox-slot { width: 5vh; height: 5.4vh; }
+.rox-quick .rox-slot-number { bottom: -1.9vh; left: 0.2vh; width: 1.35vh; height: 1.35vh; font-size: 0.9vh; }
+.rox-quick .rox-slot-count { font-size: 0.85vh; }
+.rox-gear { display: grid; gap: 0.9vh; }
+.rox-gear .rox-slot { width: 17.5vh; height: 6.6vh; }
+.rox-gear .rox-slot-img { inset: 10% 30%; }
+
+/* amount + buttons (under gear) */
+.inventory-control { justify-content: flex-start !important; margin-top: 1.6vh; }
+.inventory-control-wrapper { align-items: stretch !important; width: 17.5vh; gap: 0.7vh !important; }
+.inventory-control-input {
+  background: transparent !important; border: 0 !important; border-bottom: 1px solid $rox-line !important; border-radius: 0 !important;
+  text-align: center; font-size: 1.4vh !important; padding: 0.6vh !important; width: 100% !important;
+}
+.rox-amount-label { text-align: center; color: #8e9096; font-size: 1.3vh; font-weight: 600; margin: -0.2vh 0 0.8vh; }
+.inventory-control-button {
+  background: rgba(30, 31, 34, 0.7) !important; border: 1px solid $rox-line !important; border-radius: 0.4vh !important;
+  font-size: 1.25vh !important; padding: 0.9vh !important; width: 100% !important;
+  &:hover { background: rgba(255, 255, 255, 0.12) !important; }
+}
+
+/* tooltip */
+.tooltip-wrapper { background: rgba(22, 22, 24, 0.96) !important; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 0.6vh !important; min-width: 26vh; max-width: 30vh; }
+.rox-tip-head { display: flex; gap: 1.1vh; align-items: center; margin-bottom: 0.6vh; }
+.rox-tip-head b { font-size: 1.45vh; font-weight: 800; display: block; line-height: 1.2; }
+.rox-tip-img { position: relative; width: 3.8vh; height: 3.8vh; flex: 0 0 auto; border-radius: 0.3vh; overflow: hidden; display: grid; place-items: center;
+  img { position: relative; width: 85%; height: 85%; object-fit: contain; } }
+.rox-tip-meta { font-size: 1.1vh; font-weight: 600; color: #9a9ca2; margin-top: 0.3vh; display: flex; align-items: center; }
+.rox-dot { display: inline-block; width: 0.65vh; height: 0.65vh; border-radius: 50%; margin-right: 0.45vh; }
+.rox-tip-sub:empty { display: none; }
+.rox-tip-actions { margin-top: 1vh; padding-top: 0.8vh; border-top: 1px solid rgba(255, 255, 255, 0.07); font-size: 1.1vh; font-weight: 600; color: #9a9ca2; display: flex; gap: 0.6vh; align-items: center; }
+.rox-weapon .rox-slot-ring, .rox-quick .rox-slot-ring, .rox-gear .rox-slot-ring { display: none; }
+.inventory-control-button { text-transform: none !important; color: #e6e7ea !important; font-weight: 600 !important; }
+
+/* ---- ROX v2: full-screen layout like the reference ---- */
+.app-wrapper::before { content: ''; position: fixed; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 35% 45%, rgba(0,0,0,.35), rgba(0,0,0,.7)); opacity: var(--rox-dim, 1); }
+.inventory-wrapper {
+  justify-content: flex-start !important;
+  gap: 4.2vw !important;
+  padding: 9vh 0 0 6.5vw !important;
+  transform: perspective(1500px) rotateY(13deg) rotateZ(-1.2deg) !important;
+  transform-origin: 0% 40% !important;
+}
+$rox-big: 11.6vh;
+.rox-left .inventory-grid-container { grid-template-columns: repeat(5, $rox-big) !important; grid-auto-rows: $rox-big !important; gap: 2.6vh 1vh !important; max-height: 78vh; }
+.rox-right .inventory-grid-container { grid-template-columns: repeat(5, 10.4vh) !important; grid-auto-rows: 10.4vh !important; gap: 1vh 0.9vh !important; }
+.rox-right { margin-left: 3vw; margin-top: 0.5vh; }
+.rox-right .inventory-grid-header-wrapper { flex-direction: row-reverse; position: relative; height: 4.6vh; }
+.rox-right .inventory-grid-header-wrapper p:not(.rox-weight) { position: absolute; left: 0; bottom: 0; }
+.rox-right .inventory-grid-header-wrapper .rox-weight { position: absolute; right: 0; top: 0; }
+.rox-slot.rarity-empty { background: linear-gradient(160deg, rgba(40,40,44,.45), rgba(18,18,20,.35)) !important; border-color: rgba(255,255,255,.07) !important; }
+.rox-slot-img { inset: 14%; }
+.rox-slot-count { font-size: 1.2vh; }
+.rox-slot-ring { width: 1.35vh; height: 1.35vh; bottom: -2vh; border-width: 0.25vh; }
+
+/* middle column */
+.rox-mid { width: 26vh !important; padding-top: 5.5vh !important; }
+.rox-h { font-size: 1.6vh; }
+.rox-pair { gap: 3.2vh; margin-bottom: 2.4vh; }
+.rox-pair-slot { width: 9.6vh; height: 9.6vh; }
+.rox-ok { right: -2.6vh; bottom: 0.2vh; width: 1.35vh; height: 1.35vh; }
+.rox-quick { gap: 1.2vh; margin-bottom: 3.4vh; }
+.rox-quick .rox-slot { width: 6.6vh; height: 7vh; }
+.rox-quick .rox-slot-number { bottom: -2.1vh; width: 1.55vh; height: 1.55vh; font-size: 1vh; }
+.rox-quick .rox-slot-count { font-size: 1vh; }
+.rox-gear .rox-slot { width: 21vh; height: 9.6vh; }
+.rox-gear { gap: 1.1vh; }
+
+/* only "Amount" under gear, no buttons (use / give from right-click menu) */
+.inventory-control { margin-top: 2.2vh !important; }
+.inventory-control-wrapper { width: 21vh !important; }
+.inventory-control-button, .useful-controls-button { display: none !important; }
+.inventory-control-input { border-bottom-color: transparent !important; color: #cfd0d3 !important; font-size: 1.5vh !important; }
+.inventory-control-input:focus { border-bottom-color: rgba(255,255,255,.15) !important; }
+.rox-amount-label { font-size: 1.45vh !important; color: #7d8086 !important; margin-top: -3.4vh !important; pointer-events: none; }
+.inventory-control-input:focus + .rox-amount-label, .inventory-control-input:not([value='0']) + .rox-amount-label { margin-top: 0 !important; }
+
+/* ---- ROX v3 tune ---- */
+.inventory-wrapper { gap: 6.5vw !important; padding: 10vh 0 0 4.2vw !important; transform: perspective(1800px) rotateY(7deg) rotateZ(-1.4deg) !important; }
+.rox-mid { width: 30vh !important; padding-top: 4.5vh !important; }
+.rox-pair-slot { width: 10.6vh; height: 10.6vh; }
+.rox-quick .rox-slot { width: 7.4vh; height: 7.8vh; }
+.rox-gear .rox-slot { width: 27vh; height: 10.8vh; }
+.inventory-control-wrapper { width: 27vh !important; }
+.rox-right { margin-left: 2vw; margin-top: -3vh; }
+.rox-right .inventory-grid-container { grid-template-columns: repeat(5, 12.4vh) !important; grid-auto-rows: 12.4vh !important; }
+.rox-left .inventory-grid-header-wrapper .rox-weight, .rox-right .inventory-grid-header-wrapper .rox-weight { font-size: 1.55vh !important; }
+.inventory-control-input[value='0']:not(:focus) { color: transparent !important; }
